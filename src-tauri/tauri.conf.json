{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hodeum",
  "version": "0.1.0",
  "identifier": "com.hodeum.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "guidance_overlay",
        "url": "overlay.html",
        "title": "Hodey guidance",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "shadow": false,
        "visible": false
      },
      {
        "label": "main_notch",
        "url": "notch.html",
        "title": "Hodey",
        "width": 600,
        "height": 340,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "shadow": false,
        "visible": false
      },
      {
        "label": "hodeum_app",
        "url": "app.html",
        "title": "Hodeum",
        "width": 1120,
        "height": 740,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
