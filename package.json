{
  "name": "hodeum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "app": "tauri build --debug --no-bundle",
    "e2e:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/e2e/start-hodeum.ps1 -CdpPort 9229",
    "e2e:ready": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/e2e/wait-ready.ps1 -CdpPort 9229",
    "e2e:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/e2e/stop-hodeum.ps1 -CdpPort 9229",
    "e2e:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/e2e/e2e-zip.ps1 -CdpPort 9229",
    "tauri:build": "npm run prebuild:dlls && tauri build --config src-tauri/tauri.bundle.conf.json",
    "prebuild:dlls": "cargo build --release --manifest-path src-tauri/Cargo.toml -p sherpa-onnx-sys",
    "test": "vitest run",
    "build:site": "vite build --config vite.site.config.ts",
    "deploy:site": "npm run build:site && node -e \"require('fs').cpSync('.vercel','dist-site/.vercel',{recursive:true})\" && vercel deploy --prod --yes --cwd dist-site"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-log": "^2.10.0",
    "@tauri-apps/plugin-sql": "^2.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.7"
  }
}
